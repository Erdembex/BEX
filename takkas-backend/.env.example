# Takkas Backend — Production Environment Template
# Copy: cp .env.example .env

# ── Database ──
DB_NAME=takkas
DB_USER=takkas
DB_PASS=CHANGE_ME_STRONG_PASSWORD
DB_URL=jdbc:postgresql://localhost:5432/takkas

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Security ──
JWT_SECRET=CHANGE_ME_MIN_32_CHARACTERS_RANDOM_STRING
BASE_URL=https://api.bex.app

# ── Admin ──
ADMIN_SEED_ENABLED=false
ADMIN_SYNC_PASSWORD=false
ADMIN_EMAIL=admin@bex.app
ADMIN_PASSWORD=CHANGE_ME

# ── Demo verisi (sunum / saha demosu) ──
# Production'da false kalmalı. Sadece demo ortamında true yapılır.
DEMO_SEED_ENABLED=false
DEMO_PASSWORD=PasslaDemo1!

# ── Production flags ──
# false = her ilan admin moderasyonundan geçer
LISTINGS_AUTO_APPROVE=false
SWAGGER_ENABLED=false
SPRING_PROFILES_ACTIVE=prod

# ── Rate limit ──
# Production'da kapatılamaz; kapatılırsa uygulama açılışta hata verir
RATE_LIMIT_ENABLED=true

# ── CORS ──
# Virgülle ayrılmış origin listesi (tarayıcı istemcileri için)
CORS_ALLOWED_ORIGINS=https://passla.com.tr,https://www.passla.com.tr

# ── File storage ──
# local = filesystem (UPLOAD_DIR), s3 = Amazon S3
STORAGE_PROVIDER=local
UPLOAD_DIR=/var/takkas/uploads

# ── Amazon S3 (STORAGE_PROVIDER=s3 iken gerekli) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=bex-media-prod
AWS_S3_REGION=eu-central-1

# ── Mail (SendGrid örneği) ──
SPRING_MAIL_HOST=smtp.sendgrid.net
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=apikey
SPRING_MAIL_PASSWORD=

# ── Firebase push ──
FIREBASE_SERVICE_ACCOUNT_PATH=/opt/takkas/firebase-sa.json

# ── Stripe (opsiyonel) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Expo push ──
EXPO_ACCESS_TOKEN=

# ── Payment provider: manual | iyzico | stripe ──
APP_PAYMENT_PROVIDER=manual

# ── İyzico (APP_PAYMENT_PROVIDER=iyzico iken) ──
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ── Docker compose ──
APP_PORT=8080
