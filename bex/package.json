  "name": "bex",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/restyle": "^2.4.5",
    "@stomp/stompjs": "^7.3.0",
    "axios": "^1.18.1",
    "expo": "^57.0.0",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.17",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.17",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "firebase": "^12.15.0",
    "leaflet": "^1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "react-native": "0.86.3",
    "react-native-drawer-layout": "^4.2.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.2.4",
    "eas-cli": "^16.17.4",
    "firebase-tools": "^15.22.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --port 8083",
    "android": "expo start --android --port 8083",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "emulators": "firebase emulators:start --only auth --project bexcursor",
    "emulators:storage": "firebase emulators:start --only auth,storage --project bexcursor",
    "emulators:full": "firebase emulators:start --only auth,firestore,storage,functions --project bexcursor",
    "functions:build": "npm --prefix functions run build",
    "deploy:functions": "npm run functions:build && firebase deploy --only functions --project bexcursor",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes --project bexcursor",
    "deploy:storage": "firebase deploy --only storage --project bexcursor",
    "build:preview": "eas build --profile preview --platform all",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview-phone:android": "eas build --profile preview-phone --platform android",
    "build:production": "eas build --profile production --platform all",
    "build:production:android": "eas build --profile production --platform android",
    "build:production:ios": "eas build --profile production --platform ios",
    "submit:android": "eas submit --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:all": "eas submit --platform all --profile production",
    "eas:secrets": "eas secret:list",
    "eas:setup-secrets": "node -e \"console.log('Windows: .\\\\scripts\\\\setup-eas-secrets.ps1 -ApiDomain api.SENIN-DOMAIN\\nUnix: ./scripts/setup-eas-secrets.sh api.SENIN-DOMAIN')\"",
    "store:verify-play": "bash scripts/verify-play-service-account.sh"
  },
  "private": true
}
