{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_BASE_URL": "http://127.0.0.1:8888",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "paa-5b0c2",
        "EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN": "paa-5b0c2.firebaseapp.com",
        "EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET": "paa-5b0c2.firebasestorage.app",
        "EXPO_PUBLIC_USE_DEMO_DATA": "false",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "1883a871-3730-4cbb-a11e-120480fbbe20"
      }
    },
    "preview-phone": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.passla.com.tr",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "paa-5b0c2",
        "EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN": "paa-5b0c2.firebaseapp.com",
        "EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET": "paa-5b0c2.firebasestorage.app",
        "EXPO_PUBLIC_USE_DEMO_DATA": "false",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "1883a871-3730-4cbb-a11e-120480fbbe20"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.passla.com.tr",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "paa-5b0c2",
        "EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN": "paa-5b0c2.firebaseapp.com",
        "EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET": "paa-5b0c2.firebasestorage.app",
        "EXPO_PUBLIC_USE_DEMO_DATA": "false",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "1883a871-3730-4cbb-a11e-120480fbbe20"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
