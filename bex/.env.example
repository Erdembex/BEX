# BEX ortam değişkenleri (opsiyonel — çoğu adım için gerekmez)
# Production: .env.production.example ve EAS_DEPLOYMENT.md dosyalarına bak

# Spring Boot REST API (Axios)
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.102:8080

# Expo push bildirimleri — `npx eas init` sonrası project id
EXPO_PUBLIC_EAS_PROJECT_ID=1883a871-3730-4cbb-a11e-120480fbbe20

# App Check — yalnızca yayına çıkmadan önce (Adım 3)
# EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=

# Web App Check (reCAPTCHA v3)
# EXPO_PUBLIC_RECAPTCHA_SITE_KEY=

# Google Maps — Android/iOS harita karoları (production build için gerekli)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
